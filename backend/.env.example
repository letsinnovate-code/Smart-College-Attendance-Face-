# =================================================================
# Smart College Attendance Management System - Environment Template
# =================================================================

# Server Environment
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000

# MongoDB Database URI (Replica Set recommended for multi-document transactions)
MONGODB_URI=mongodb://localhost:27017/smart_attendance

# Authentication & JWT Secrets (Must be at least 32 characters in production)
ACCESS_TOKEN_SECRET=replace_with_a_secure_random_32_character_string_for_access
REFRESH_TOKEN_SECRET=replace_with_a_secure_random_32_character_string_for_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cookies & Security
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Redis (Optional: Rate-limiting store & BullMQ background worker queue)
# If omitted, rate limiting uses in-memory store and tasks run directly.
# REDIS_URL=redis://localhost:6379

# Face Recognition Provider:
# - 'onnx': Local CPU inference via ONNX Runtime & ArcFace model
# - 'http': Calls Python FastAPI sidecar microservice (InsightFace + GPU)
# - 'mock': Test provider returning synthetic vectors (BLOCKED IN PRODUCTION)
FACE_PROVIDER=onnx
FACE_MODEL_VERSION=arcface-r100
FACE_SIMILARITY_THRESHOLD=0.60
FACE_LIVENESS_ENABLED=false

# Python Face Sidecar settings (Only when FACE_PROVIDER=http)
# FACE_PROVIDER_URL=http://face-sidecar:8000
# FACE_PROVIDER_API_KEY=your_sidecar_shared_secret_key

# Biometric Vector Encryption (AES-256-GCM, 64 hex characters = 32 bytes)
# Generate via: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
BIOMETRIC_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upload File Limit (Default: 5 MB)
UPLOAD_MAX_BYTES=5242880

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# Email Delivery (Optional: smtp, sendgrid, or none)
EMAIL_PROVIDER=none
