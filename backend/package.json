{
  "name": "smart-attendance-backend",
  "version": "1.0.0",
  "description": "Production-ready Smart College Attendance Management System with Face Recognition",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:concurrency": "vitest run tests/concurrency",
    "db:indexes": "node scripts/ensure-indexes.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "argon2": "^0.43.0",
    "bullmq": "^5.28.6",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "http-terminator": "^3.2.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "multer": "^2.5.0",
    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "rate-limit-redis": "^4.2.0",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.3",
    "prettier": "^3.4.2",
    "supertest": "^7.3.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "attendance",
    "face-recognition",
    "college",
    "biometric",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "Smart Attendance Team",
  "license": "UNLICENSED"
}
